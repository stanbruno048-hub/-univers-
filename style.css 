/* Conteneur général du chat */
.chat-container {
  background: #e5ddd5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  padding: 16px;
  max-width: 600px;
  margin: 0 auto;
  min-height: 100vh;
}

/* Mode sombre WhatsApp */
@media (prefers-color-scheme: dark) {
  .chat-container {
    background: #0b141a;
  }
}

/* Ligne de message */
.message-row {
  display: flex;
  margin-bottom: 8px;
}

.message-row.sent {
  justify-content: flex-end;
}

.message-row.received {
  justify-content: flex-start;
}

/* Bulle de message */
.message-bubble {
  max-width: 70%;
  padding: 8px 12px 6px 12px;
  border-radius: 8px;
  position: relative;
  word-wrap: break-word;
  line-height: 1.4;
  font-size: 14.2px;
  box-shadow: 0 1px 0.5px rgba(0, 0, 0, 0.13);
}

/* Bulle envoyée - vert WhatsApp */
.message-bubble.sent {
  background: #d9fdd3;
  border-top-right-radius: 2px;
  color: #111b21;
}

/* Bulle reçue - blanc/gris */
.message-bubble.received {
  background: #ffffff;
  border-top-left-radius: 2px;
  color: #111b21;
}

/* Mode sombre */
@media (prefers-color-scheme: dark) {
  .message-bubble.sent {
    background: #005c4b;
    color: #e9edef;
  }
  .message-bubble.received {
    background: #202c33;
    color: #e9edef;
  }
}

/* Heure et double coche */
.message-meta {
  font-size: 11px;
  color: #667781;
  float: right;
  margin-left: 8px;
  margin-top: 4px;
  display: flex;
  align-items: center;
  gap: 4px;
}

@media (prefers-color-scheme: dark) {
  .message-meta {
    color: #8696a0;
  }
}

/* Double coche lue en bleu */
.message-meta.read::after {
  content: "✓";
  color: #53bdeb;
  font-weight: bold;
}

.message-meta::after {
  content: "✓";
  color: #667781;
}

/* Petite pointe de la bulle */
.message-bubble.sent::before {
  content: "";
  position: absolute;
  top: 0;
  right: -6px;
  width: 0;
  height: 0;
  border: 6px solid transparent;
  border-top-color: #d9fdd3;
  border-right: 0;
  border-left: 0;
}

.message-bubble.received::before {
  content: "";
  position: absolute;
  top: 0;
  left: -6px;
  width: 0;
  height: 0;
  border: 6px solid transparent;
  border-top-color: #ffffff;
  border-right: 0;
  border-left: 0;
}

@media (prefers-color-scheme: dark) {
  .message-bubble.sent::before {
    border-top-color: #005c4b;
  }
  .message-bubble.received::before {
    border-top-color: #202c33;
  }
} 